# ---- Database ----
# PostgreSQL (canonical / production & local docker)
DATABASE_URL="postgresql://mhm:mhm@localhost:5432/minhag_hamedina?schema=public"
# For SQLite test runs the db:sqlite script overrides this to: file:./prisma/test.db

# ---- API ----
PORT=3000
API_PREFIX="api/v1"
JWT_SECRET="dev-super-secret-change-me"
JWT_EXPIRES_IN="30d"

# ---- Identity verification ----
# dev | live  — "dev" accepts signed dev tokens so OAuth secrets are not required to build/run.
IDENTITY_MODE="dev"
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# ---- Anti-fraud ----
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=120

# ---- Web ----
VITE_API_BASE_URL="http://localhost:3000/api/v1"
