# ============================================================================
#  Minhag HaMedina — environment configuration
#  Copy to .env and fill real values for production. NEVER commit a real .env.
# ============================================================================

# ---- Runtime ----
# Set to "production" in prod. In production the API REFUSES to boot if
# JWT_SECRET is missing or left at the dev default below.
NODE_ENV="development"

# ---- Database ----
# PostgreSQL (canonical / production & docker compose).
DATABASE_URL="postgresql://mhm:mhm@localhost:5432/minhag_hamedina?schema=public"
# Dev/test SQLite runs use the db:sqlite script which overrides this to file:./dev.db

# ---- API ----
PORT=3000
API_PREFIX="api/v1"
# CHANGE THIS in production (the API will not boot in prod with this default).
JWT_SECRET="dev-super-secret-change-me"
JWT_EXPIRES_IN="30d"
# Static admin bearer token guarding admin routes + the admin console login.
ADMIN_API_TOKEN="dev-admin-token"

# ---- CORS ----
# Comma-separated allowlist of origins, enforced in production. In dev (NODE_ENV
# != production) or when empty, all origins are reflected. Example for prod:
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ORIGINS=""

# ---- Identity verification ----
# dev | live — "dev" accepts signed dev tokens so OAuth secrets are not needed to run.
IDENTITY_MODE="dev"
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# ---- Anti-fraud ----
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=120
# Proof-of-Work gate on anonymous login (off by default; turn on to require a
# solved challenge). POW_SECRET defaults to deriving from JWT_SECRET.
POW_ENABLED="false"
POW_DIFFICULTY=4
POW_SECRET=""

# ---- Image upload ----
# Directory where uploaded question images are stored + served from /uploads.
UPLOADS_DIR="./uploads"
# Optional absolute prefix for returned image URLs (e.g. a CDN); default is a relative path.
PUBLIC_BASE_URL=""

# ---- Push notifications (FCM HTTP v1) ----
# All optional — when unset, a no-op log sender is used instead of real FCM.
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT=""
FCM_SERVER_KEY=""

# ---- Web + Admin clients (baked in at build time by Vite) ----
VITE_API_BASE_URL="http://localhost:3000/api/v1"
# Optional real OAuth on the web client (falls back to dev sign-in when unset).
VITE_GOOGLE_CLIENT_ID=""
VITE_APPLE_CLIENT_ID=""
VITE_APPLE_REDIRECT_URI=""
