{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "strictPropertyInitialization": false,
    "types": ["node", "multer"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
